class LevelSelection:
    def __init__(self):
        self.LVL1_RECT = pygame.Rect(200,200,150,100)
        self.LVL2_RECT = pygame.Rect(400,200,150,100)

    def handleEvents(self, events):
        for e in events:
            if e.type==QUIT:
                return "quit"
            if e.type==MOUSEBUTTONDOWN and e.button==1:
                if self.LVL1_RECT.collidepoint(e.pos):
                    return "level1"
                if self.LVL2_RECT.collidepoint(e.pos):
                    return "level2"

    def update(self,dt):
        pass

    def draw(self):
        begin_2d()
        pygame.draw.rect(SCREEN,WHITE,self.LVL1_RECT)
        pygame.draw.rect(SCREEN,WHITE,self.LVL2_RECT)
        end_2d()

