class MainMenu:
    def __init__(self):
        pygame.mouse.set_visible(True)
        pygame.event.set_grab(False)

        self.START_RECT = pygame.Rect(860,300,200,60)
        self.QUIT_RECT  = pygame.Rect(860,400,200,60)

    def handleEvents(self,events):
        for e in events:
            if e.type==QUIT:
                return "quit"
            if e.type==MOUSEBUTTONDOWN and e.button==1:
                if self.START_RECT.collidepoint(e.pos):
                    return "start"
                if self.QUIT_RECT.collidepoint(e.pos):
                    return "quit"

    def update(self,dt):
        pass

    def draw(self):
        glClear(GL_COLOR_BUFFER_BIT)

        begin_2d()
        pygame.draw.rect(SCREEN,WHITE,self.START_RECT)
        pygame.draw.rect(SCREEN,WHITE,self.QUIT_RECT)
        end_2d()

# =====================================================================================
def main_menu():
    currentState = MainMenu()

    running=True
    while running:
        dt=clock.tick(60)/1000
        events=pygame.event.get()

        result=None
        if hasattr(currentState,"handleEvents"):
            result=currentState.handleEvents(events)

        if result=="quit":
            running=False
        elif result=="start":
            currentState=LvlOne()

        currentState.update(dt)
        currentState.draw()

        pygame.display.flip()

    pygame.quit()

if __name__=="__main__":
    main_menu()
